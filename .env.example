# 用于签名访问令牌和下单确认令牌；生产环境必须替换为随机强密钥。
SHOP_SECRET_KEY=replace-with-a-long-random-secret

# 访问令牌的有效期，单位为分钟。
SHOP_TOKEN_EXPIRE_MINUTES=60

# MCP 下单确认令牌的有效期，单位为秒。
SHOP_CONFIRMATION_EXPIRE_SECONDS=300

# 数据库连接地址；默认使用项目根目录的 SQLite 文件。设为 memory:// 可关闭持久化。
SHOP_DATABASE_URL=sqlite:///./shop.db

# 对外暴露的基础地址，用于 OAuth 发现元数据与登录页回跳；经反代或远程访问时请设为实际公网地址。
SHOP_BASE_URL=http://127.0.0.1:8000
