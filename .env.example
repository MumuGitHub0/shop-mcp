# 复制为 .env 后按需修改；所有变量均有缺省值，不配置也可运行。

# ---------- 数据库 ----------
# SQLite（默认）：相对路径基于项目根目录
SHOP_DATABASE_URL=sqlite:///./shop.db
# MySQL 示例（需先安装 extras：uv sync --extra mysql）：
# SHOP_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/shop?charset=utf8mb4
# 首次连接请保证库已创建（CREATE DATABASE shop CHARACTER SET utf8mb4）；
# 表结构由 Alembic 在启动时自动创建/升级。

# 启动时是否自动执行 Alembic upgrade（1=开启，0=关闭由运维手工执行）
SHOP_DB_AUTO_UPGRADE=1

# ---------- Redis（可选加速层） ----------
# 留空则不启用 Redis，全部走数据库；数据库始终是唯一事实来源。
# 需先安装 extras：uv sync --extra redis
SHOP_REDIS_URL=

# ---------- 认证 ----------
# 用于签名访问令牌和下单确认令牌；生产环境必须替换为随机强密钥。
SHOP_SECRET_KEY=replace-with-a-long-random-secret
# 访问令牌的有效期，单位为分钟。
SHOP_TOKEN_EXPIRE_MINUTES=60
# MCP 下单确认令牌的有效期，单位为秒。
SHOP_CONFIRMATION_EXPIRE_SECONDS=300

# 对外暴露的基础地址，用于 OAuth 发现元数据与登录页回跳；经反代或远程访问时请设为实际公网地址。
SHOP_BASE_URL=http://127.0.0.1:8000
